{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scam-with-your-friends-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-04",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scam-with-your-friends-web-db",
      "database_id": "bea3a6c6-1343-4573-b8b8-4334ed788246",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "OfficeRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "OfficeRoom"
      ]
    }
  ],
  "observability": {
    "enabled": true
  },
    "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ACCOUNTS_ENABLED": "false",
    "AI_BASE_URL": "https://api.groq.com/openai/v1",
    "AI_MODEL": "openai/gpt-oss-20b"
  }
}
